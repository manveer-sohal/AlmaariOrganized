# --- Database ---
MONGODB_URI="your_mongodb_connection_string"

# --- Redis (optional cache) ---
REDIS_URL="your_redis_url"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# --- CORS ---
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# --- Internal server-to-server auth (Auth0 login bootstrap) ---
# Shared secret between Next.js (server) and this API. Never expose to the browser.
INTERNAL_API_SECRET="generate_a_long_random_string"

# --- Upload limits ---
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_DIMENSION=8000
UPLOAD_MIN_DIMENSION=32

# --- Rate limits (per IP, per window) ---
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_AI_ANALYZE_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=15
RATE_LIMIT_WEATHER_PER_MIN=30
RATE_LIMIT_LOGIN_PER_15_MIN=30

# --- Auth0 (server-side JWT validation for protected API routes) ---
# Domain only, e.g. your-tenant.us.auth0.com (from AUTH0_ISSUER_BASE_URL).
AUTH0_DOMAIN="your-tenant.us.auth0.com"
# Auth0 API identifier (audience) — must match frontend AUTH0_AUDIENCE.
# Create an API in Auth0 Dashboard → APIs and use its Identifier here.
AUTH0_AUDIENCE="https://your-api-identifier"
# Optional: OpenAI reranking for stylist recommendations (falls back to rules if unset).
# OPENAI_API_KEY="sk-..."
# OPENAI_STYLIST_MODEL="gpt-4o-mini"
# RATE_LIMIT_AI_STYLIST_PER_MIN=10
# SERVICE_NAME="almaari-api"
# AI_ANALYZE_TIMING=true
# CROP_TIMEOUT_MS=15000
# AI_CLOTHING_TIMEOUT_MS=60000
TOMORROW_API_KEY="your_weather_api_key"
CROP_SERVICE_URL="https://your-crop-service-url"
# Server-only shared secret for Express → crop service (never NEXT_PUBLIC_).
CROP_SERVICE_API_KEY="generate_a_long_random_string"
AI_CLOTHING_SERVICE_URL="https://your-ai-service-url"
# Server-only shared secret for Express → analysis service.
AI_CLOTHING_SERVICE_API_KEY="generate_a_long_random_string"
# Optional: allow Python/Express to skip service keys in local/dev only.
# ALLOW_INSECURE_SERVICE_AUTH=true
# Durable enrichment worker secret (internal /api/internal/enrichment/process).
ENRICHMENT_WORKER_SECRET="generate_a_long_random_string"
# Image storage (legacy Base64 by default; set s3 when ready — does not auto-migrate).
IMAGE_STORAGE_PROVIDER=legacy
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket
# AWS_CLOUDFRONT_DOMAIN=cdn.example.com

# --- Stripe billing (credit purchases) ---
# Secret key: server-side only, NEVER expose to the frontend.
STRIPE_SECRET_KEY="sk_test_..."
# Publishable key: safe to send to the frontend (returned via /api/billing/config).
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret from `stripe listen` (dev) or the Dashboard endpoint (prod).
STRIPE_WEBHOOK_SECRET="whsec_..."
